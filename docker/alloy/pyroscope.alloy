declare "pyroscope_collect" {
    pyroscope.receive_http "default" {
      http {
        listen_address = "0.0.0.0"
        listen_port = 8888
      }
      forward_to = [pyroscope.write.production.receiver]
    }

    pyroscope.write "production" {
      endpoint {
        url = "http://pyroscope:4040"
      }
    }
}
